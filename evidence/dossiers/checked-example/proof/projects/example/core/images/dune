; example/core: elf-snapshot turns each of our two ELF files into a memory image (as pupnp's images/dune does).
(rule
 (targets Plain.v Plain_seg_000.hex Plain_seg_001.hex Plain_seg_002.hex Plain_seg_003.hex)
 (deps (:elf %{project_root}/projects/example/bin/core/core.plain))
 (action
  (run elf-snapshot %{elf} Plain.v --prefix Plain --module-name M
       --namespace OssFuzzTheorems.example.core.images)))
(rule
 (targets Asan.v Asan_seg_000.hex Asan_seg_001.hex Asan_seg_002.hex Asan_seg_003.hex)
 (deps (:elf %{project_root}/projects/example/bin/core/core.asan))
 (action
  (run elf-snapshot %{elf} Asan.v --prefix Asan --module-name M
       --namespace OssFuzzTheorems.example.core.images)))
